+                .unwrap()
+                .position_and_size()
+                .is_pinned,
+            pinned
+        );
+        assert_eq!(tab.get_active_pane_id(1), Some(PaneId::Terminal(1)));
+        if overlay {
+            tab.floating_panes.resize(Size {
+                cols: 100,
+                rows: 18,
+            });
+            let resized = tab.get_pane_info(pane_id).unwrap();
+            assert_eq!((resized.pane_x, resized.pane_y), (37, 1));
+            tab.floating_panes
+                .change_pane_coordinates(
