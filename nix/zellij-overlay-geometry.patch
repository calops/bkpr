+                    .with_width_fixed(30)
+                    .with_height_fixed(8)
+            }),
+            None,
+        ).unwrap();
+        tab.set_pane_selectable(PaneId::Plugin(plugin_id), false);
+        tab.update_focus_follows_mouse(true);
+    }
+    screen.go_to_tab(1, 1).unwrap();
+    while plugin_receiver.try_recv().is_ok() {}
