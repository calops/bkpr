+                    && later.iter().any(|next| {
+                        next.plugin_id == asset.plugin_id && next.client_id == asset.client_id
+                    }))
+            {
+                asset.render_messages.clear();
+            }
+            self.render_blocker.remove_blocking_plugin(asset.plugin_id);
+        }
+        self.render(Some(plugin_render_assets))
