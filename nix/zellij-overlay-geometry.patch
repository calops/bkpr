+fn pinned_borderless_plugin_overlay_uses_display_coordinates() {
+    use zellij_utils::data::FloatingPaneCoordinates;
+    use zellij_utils::pane_size::Viewport;
+
+    let size = Size {
+        cols: 121,
+        rows: 20,
