+            assert_eq!((unpinned.pane_x, unpinned.pane_y), (38, 2));
+            assert!(
+                !tab.floating_panes
+                    .get_pane(pane_id)
+                    .unwrap()
+                    .position_and_size()
+                    .is_pinned
+            );
+        }
+    }
+}
