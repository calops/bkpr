+    fn clear_vacated_ui_overlay_surface(&mut self) {
+        use std::fmt::Write as _;
+
+        self.ui_overlay_damage.clear();
+        self.ui_overlay_geometries.clear();
+        if !self.tiled_panes.fullscreen_covers_ui() {
+            self.floating_panes
+                .collect_ui_overlay_geometries(&mut self.ui_overlay_geometries);
+        }
+        let display = *self.display_area.borrow();
+        for (id, old) in &self.previous_ui_overlay_geometries {
+            let vacated = match self.ui_overlay_geometries.binary_search_by_key(id, |(id, _)| *id) {
+                Ok(index) => {
+                    let current = &self.ui_overlay_geometries[index].1;
+                    current.x > old.x
+                        || current.y > old.y
+                        || current.x + current.cols.as_usize() < old.x + old.cols.as_usize()
+                        || current.y + current.rows.as_usize() < old.y + old.rows.as_usize()
+                }
+                Err(_) => true,
+            };
+            if !vacated {
+                continue;
+            }
+            let right = (old.x + old.cols.as_usize()).min(display.cols);
+            let bottom = (old.y + old.rows.as_usize()).min(display.rows);
+            if old.x < right {
+                for row in old.y..bottom {
+                    write!(
+                        self.ui_overlay_damage,
+                        "\u{1b}[{};{}H\u{1b}[{}X",
+                        row + 1,
+                        old.x + 1,
+                        right - old.x
+                    ).unwrap();
+                }
+            }
+        }
+        std::mem::swap(
+            &mut self.previous_ui_overlay_geometries,
+            &mut self.ui_overlay_geometries,
+        );
+        if !self.ui_overlay_damage.is_empty() {
+            // Repaint only after clearing the old overlay, including unowned chrome cells.
+            self.set_force_render();
+        }
+    }
