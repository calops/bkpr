+fn coordinate_viewport(
+    pane: &dyn Pane,
+    is_pinned: bool,
+    display_area: Size,
+    viewport: Viewport,
+) -> Viewport {
+    if is_pinned && pane.borderless() && matches!(pane.pid(), PaneId::Plugin(_)) {
+        // Pinned borderless UI, including focused modals, can cover reserved chrome.
+        Viewport {
+            x: 0,
+            y: 0,
+            cols: display_area.cols,
+            rows: display_area.rows,
+        }
+    } else {
