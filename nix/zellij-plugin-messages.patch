+#[test]
+fn plugin_origin_spawn_uses_source_tab_but_cli_and_keybind_do_not() {
+    let directory = tempfile::tempdir().unwrap();
+    let (screen_sender, screen_receiver) = unbounded();
+    let senders = ThreadSenders {
+        to_screen: Some(SenderWithContext::new(screen_sender)), should_silently_fail: true,
+        ..Default::default()
+    };
+    let mut bridge = WasmBridge::new(senders.clone(), Engine::default(), directory.path().to_path_buf(),
+        PathBuf::from("/bin/sh"), directory.path().to_path_buf(), Default::default(),
+        None, None, vec![], vec![], InputMode::Normal, Keybinds::default());
+    bridge.connected_clients.lock().unwrap().push(2);
+    let (guest, _) = running_guest(77, 2, 5, b"card", false);
+    bridge.plugin_map.lock().unwrap().insert(77, 2, Arc::new(Mutex::new(guest)),
+        Arc::new(Mutex::new(HashSet::new())), HashMap::new());
+    let mut bus = Bus::<PluginInstruction>::empty();
+    bus.senders = senders;
+    for (index, source, expected_tab) in [
+        (0, PipeSource::Plugin(77), Some(5)),
+        (1, PipeSource::Cli("cli".into()), None),
+        (2, PipeSource::Keybind, None),
+    ] {
+        let path = directory.path().join(format!("destination-{index}.wasm"));
+        std::fs::write(&path, guest_module(b"card", false)).unwrap();
+        let mut messages = Vec::new();
+        super::super::pipe_to_specific_plugins(source, &format!("file:{}", path.display()),
+            &None, &None, false, true, &None, &None, Some(2), &mut messages,
+            "generic-launch", &None, &None, &bus, &mut bridge, &PluginAliases::default(),
+            None, Some(true)); // source routing is generic, not pinned/passive-only
+        assert_eq!(messages.len(), 1);
+        let spawned_id = messages[0].0.unwrap();
+        loop {
+            match screen_receiver.recv_timeout(Duration::from_secs(5)).unwrap().0 {
+                ScreenInstruction::AddPlugin(_, _, _, _, _, tab_index, plugin_id, ..) => {
+                    assert_eq!(plugin_id, spawned_id);
+                    assert_eq!(tab_index, expected_tab);
+                    break;
+                },
+                _ => {},
+            }
+        }
+        let deadline = std::time::Instant::now() + Duration::from_secs(5);
+        loop {
+            if let Some(plugin) = bridge.plugin_map.lock().unwrap().get_running_plugin(spawned_id, Some(2)) {
+                assert_eq!(plugin.lock().unwrap().store.data().tab_index, expected_tab);
+                break;
+            }
+            assert!(std::time::Instant::now() < deadline, "guest did not load");
+            std::thread::yield_now();
+        }
+    }
+}
