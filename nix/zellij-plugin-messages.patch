+#[test]
+fn normal_update_and_pipe_commands_are_immediate() {
+    let (mut guest, receiver) = running_guest(17, 2, 5, b"card", false);
+    let mut assets = Vec::new();
+    let senders = guest.store.data().senders.clone();
+    apply_event_to_plugin(17, 2, &mut guest, &Event::CustomMessage("normal".into(), "update".into()),
+        &mut assets, senders.clone(), &HashSet::new()).unwrap();
+    assert_eq!(assets.len(), 1);
+    assert_eq!(assets[0].bytes, b"card");
+    assert_eq!(assets[0].render_messages.len(), 2);
+    match receiver.try_recv().unwrap().0 {
+        PluginInstruction::MessageFromPlugin { source_plugin_id, message } => {
+            assert_eq!(source_plugin_id, 17);
+            assert_eq!(message.message_name, "immediate-update");
+        },
+        instruction => panic!("unexpected instruction: {instruction:?}"),
+    }
+    let pipe = PipeMessage::new(PipeSource::Plugin(99), "normal", &None, &None, true);
+    apply_pipe_message_to_plugin(17, 2, &mut guest, &pipe, &mut assets, &senders).unwrap();
+    assert_eq!(assets.len(), 2);
+    assert_eq!(assets[1].bytes, b"card");
+    assert_eq!(assets[1].render_messages.len(), 2);
+    assert!(matches!(receiver.try_recv().unwrap().0,
+        PluginInstruction::MessageFromPlugin { message, .. } if message.message_name == "immediate-update"));
+    assert!(receiver.try_recv().is_err());
+}
