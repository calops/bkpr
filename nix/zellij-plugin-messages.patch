+#[test]
+fn mode_info_json_preserves_pipe_identity_and_legacy_mode_delivery() {
+    use zellij_utils::data::{BareKey, KeyModifier, KeyWithModifier, ModeInfo};
+    use zellij_utils::input::actions::Action;
+
+    for format in [None, Some("protobuf"), Some("json")] {
+        for initial_keybinds in [false, true] {
+            for base_mode in [None, Some(InputMode::Normal)] {
+                let (mut guest, receiver) = running_guest(17, 2, 5, b"mode frame", false);
+                let key = KeyWithModifier {
+                    bare_key: BareKey::Char('x'),
+                    key_modifiers: [KeyModifier::Ctrl].into_iter().collect(),
+                };
+                let action = Action::KeybindPipe {
+                    name: Some("arbitrary-controls".into()),
+                    payload: Some("toggle-guide".into()),
+                    args: Some(BTreeMap::from([("argument".into(), "value".into())])),
+                    plugin: Some("file:/custom/controls.wasm".into()),
+                    plugin_id: None,
+                    configuration: Some(BTreeMap::from([("custom".into(), "setting".into())])),
+                    launch_new: false,
+                    skip_cache: false,
+                    floating: Some(true),
+                    in_place: Some(false),
+                    cwd: Some(PathBuf::from("/custom/cwd")),
+                    pane_title: Some("Custom controls".into()),
+                };
+                let env = guest.store.data_mut();
+                env.default_mode = InputMode::Locked;
+                env.keybinds.get_input_mode_mut(&InputMode::Locked).insert(key, vec![action]);
+                if let Some(format) = format {
+                    env.plugin.initial_userspace_configuration.insert("mode_info_format", format);
+                }
+                let subscriptions = if initial_keybinds {
+                    HashSet::from([EventType::InitialKeybinds])
+                } else {
+                    HashSet::new()
+                };
+                let mode = ModeInfo {
+                    mode: InputMode::Pane,
+                    base_mode,
+                    // Deliberately stale event data must yield to the client's effective keymap.
+                    keybinds: vec![(InputMode::Normal, vec![])],
+                    session_name: Some("custom-session".into()),
+                    editor: Some(PathBuf::from("/custom/editor")),
+                    shell: Some(PathBuf::from("/custom/shell")),
+                    ..Default::default()
+                };
+                let mut expected = mode.clone();
+                expected.base_mode = Some(base_mode.unwrap_or(InputMode::Locked));
+                expected.keybinds = if initial_keybinds {
+                    vec![]
+                } else {
+                    guest.store.data().keybinds.to_keybinds_vec()
+                };
+                let senders = guest.store.data().senders.clone();
+                let mut assets = Vec::new();
+                apply_event_to_plugin(17, 2, &mut guest, &Event::ModeUpdate(mode),
+                    &mut assets, senders, &subscriptions).unwrap();
+                let delivered = delivered_event(&guest);
+                if format == Some("json") {
+                    match delivered {
+                        Event::CustomMessage(name, payload) => {
+                            assert_eq!(name, "mode_info");
+                            let actual: ModeInfo = serde_json::from_str(&payload).unwrap();
+                            assert_eq!(actual, expected);
+                        },
+                        event => panic!("expected lossless mode_info, received {event:?}"),
+                    }
+                } else {
+                    let legacy: ProtobufEvent = Event::ModeUpdate(expected).try_into().unwrap();
+                    let legacy: Event = legacy.try_into().unwrap();
+                    assert_eq!(delivered, legacy);
+                    if !initial_keybinds {
+                        match delivered {
+                            Event::ModeUpdate(mode) => assert!(matches!(
+                                &mode.keybinds[0].1[0].1[0],
+                                Action::KeybindPipe { name: None, payload: None, plugin: None, .. }
+                            )),
+                            event => panic!("legacy plugin received {event:?}"),
+                        }
+                    }
+                }
+                // Exactly one callback/render; no paired partial/full event or deferred command.
+                assert_eq!(assets.len(), 1);
+                assert_eq!(assets[0].bytes, b"mode frame");
+                assert!(matches!(receiver.try_recv().unwrap().0,
+                    PluginInstruction::MessageFromPlugin { message, .. }
+                        if message.message_name == "immediate-update"));
+                assert!(receiver.try_recv().is_err());
+                if initial_keybinds {
+                    let keys = Event::InitialKeybinds(
+                        guest.store.data().keybinds.to_keybinds_vec(),
+                    );
+                    let senders = guest.store.data().senders.clone();
+                    apply_event_to_plugin(17, 2, &mut guest, &keys,
+                        &mut assets, senders, &subscriptions).unwrap();
+                    let delivered = delivered_event(&guest);
+                    if format == Some("json") {
+                        match delivered {
+                            Event::CustomMessage(name, payload) => {
+                                assert_eq!(name, "keybinds_info");
+                                let actual = serde_json::from_str(&payload).unwrap();
+                                // Cached keys retain pipe identity, payload and configuration.
+                                assert_eq!(Event::InitialKeybinds(actual), keys);
+                            },
+                            event => panic!("expected lossless keybinds_info, received {event:?}"),
+                        }
+                    } else {
+                        let legacy: ProtobufEvent = keys.try_into().unwrap();
+                        let legacy: Event = legacy.try_into().unwrap();
+                        assert_eq!(delivered, legacy);
+                    }
+                    assert!(matches!(receiver.try_recv().unwrap().0,
+                        PluginInstruction::MessageFromPlugin { message, .. }
+                            if message.message_name == "immediate-update"));
+                    assert!(receiver.try_recv().is_err());
+                }
+            }
+        }
+    }
+}
