+// A real WASI guest: fd_write serializes SDK commands on stdout, invokes the
+// native command decoder, then writes the ANSI frame. No prebuilt fixture needed.
+fn guest_module(frame: &[u8], trap: bool) -> Vec<u8> {
+    fn unsigned(mut value: usize) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        loop {
+            let byte = (value & 127) as u8;
+            value >>= 7;
+            bytes.push(byte | if value != 0 { 128 } else { 0 });
+            if value == 0 { return bytes; }
+        }
+    }
+    fn signed(mut value: i32) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        loop {
+            let byte = (value & 127) as u8;
+            value >>= 7;
+            let done = (value == 0 && byte & 64 == 0) || (value == -1 && byte & 64 != 0);
+            bytes.push(byte | if done { 0 } else { 128 });
+            if done { return bytes; }
+        }
+    }
+    fn name(value: &str) -> Vec<u8> {
+        let mut bytes = unsigned(value.len());
+        bytes.extend_from_slice(value.as_bytes());
+        bytes
+    }
+    fn section(module: &mut Vec<u8>, id: u8, data: Vec<u8>) {
+        module.push(id);
+        module.extend(unsigned(data.len()));
+        module.extend(data);
+    }
+    fn write(iovec: i32) -> Vec<u8> {
+        let mut code = vec![0x41, 1, 0x41];
+        code.extend(signed(iovec));
+        code.extend([0x41, 1, 0x41, 0, 0x10, 0, 0x1a]);
+        code
+    }
+    let mut memory = vec![0; 1024];
+    let mut write_payload = |index: usize, payload: &[u8]| {
+        let pointer = memory.len() as u32;
+        let iovec = 16 + index * 8;
+        memory[iovec..iovec + 4].copy_from_slice(&pointer.to_le_bytes());
+        memory[iovec + 4..iovec + 8].copy_from_slice(&(payload.len() as u32).to_le_bytes());
+        memory.extend_from_slice(payload);
+    };
+    for (index, message_name) in ["arbitrary-frame-one", "arbitrary-frame-two", "immediate-update"].iter().enumerate() {
+        let command: ProtobufPluginCommand = PluginCommand::MessageToPlugin(
+            MessageToPlugin::new(*message_name)
+        ).try_into().unwrap();
+        let payload = serde_json::to_vec(&command.encode_to_vec()).unwrap();
+        write_payload(index, &payload);
+    }
+    write_payload(3, frame);
+    let mut module = b"\0asm\x01\0\0\0".to_vec();
+    section(&mut module, 1, vec![4,
+        0x60, 4, 0x7f, 0x7f, 0x7f, 0x7f, 1, 0x7f,
+        0x60, 0, 0,
+        0x60, 2, 0x7f, 0x7f, 0,
+        0x60, 0, 1, 0x7f]);
+    let mut imports = vec![2];
+    imports.extend(name("wasi_snapshot_preview1"));
+    imports.extend(name("fd_write"));
+    imports.extend([0, 0]);
+    imports.extend(name("zellij"));
+    imports.extend(name("host_run_plugin_command"));
+    imports.extend([0, 1]);
+    section(&mut module, 2, imports);
+    section(&mut module, 3, vec![4, 2, 3, 1, 3]);
+    section(&mut module, 5, vec![1, 0, 1]);
+    let mut exports = vec![6];
+    for (export, kind, index) in [("memory", 2, 0), ("render", 0, 2), ("update", 0, 3), ("load", 0, 4), ("pipe", 0, 5), ("_start", 0, 4)] {
+        exports.extend(name(export));
+        exports.extend([kind, index]);
+    }
+    section(&mut module, 7, exports);
+    let mut render = vec![0]; // no locals
+    for iovec in [16, 24] {
+        render.extend(write(iovec));
+        render.extend([0x10, 1]);
+    }
+    render.extend(write(40));
+    if trap { render.push(0); }
+    render.push(0x0b);
+    let mut update = vec![0];
+    update.extend(write(32));
+    update.extend([0x10, 1, 0x41, 1, 0x0b]);
+    let mut code = vec![4];
+    for body in [&render, &update, &vec![0, 0x0b], &update] {
+        code.extend(unsigned(body.len()));
+        code.extend(body);
+    }
+    section(&mut module, 10, code);
+    let mut data = vec![1, 0, 0x41, 0, 0x0b];
+    data.extend(unsigned(memory.len()));
+    data.extend(memory);
+    section(&mut module, 11, data);
+    module
+}
