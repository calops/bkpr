+#[test]
+fn failed_empty_and_invalid_guest_frames_do_not_publish_messages() {
+    for (frame, trap) in [(b"partial".as_slice(), true), (b"".as_slice(), false), (&[0xff], false)] {
+        let (mut guest, receiver) = running_guest(17, 2, 5, frame, trap);
+        let result = guest.render();
+        if frame.is_empty() {
+            assert!(result.unwrap().render_messages.is_empty());
+        } else {
+            assert!(result.is_err());
+        }
+        assert!(receiver.try_recv().is_err());
+        assert!(guest.store.data().render_messages.borrow().is_none());
+        assert!(guest.store.data().stdout_pipe.lock().unwrap().is_empty());
+        // A normal callback after a failed frame is not accidentally deferred.
+        let instance = guest.instance;
+        instance.get_typed_func::<(), i32>(&mut guest.store, "update").unwrap()
+            .call(&mut guest.store, ()).unwrap();
+        assert!(matches!(receiver.try_recv().unwrap().0, PluginInstruction::MessageFromPlugin { .. }));
+    }
+}
