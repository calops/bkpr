+#[test]
+fn generic_render_messages_follow_their_guest_frame() {
+    let frame = b"\x1b[2J\x1b[Hcomplete card";
+    for (plugin_id, client_id) in [(17, 2), (18, 3), (17, 4)] {
+        let (mut guest, receiver) = running_guest(plugin_id, client_id, 5, frame, false);
+        let asset = guest.render().unwrap();
+        assert_eq!((asset.plugin_id, asset.client_id), (plugin_id, client_id));
+        assert_eq!(asset.bytes, frame);
+        assert_eq!(asset.render_messages.iter().map(|message| message.message_name.as_str()).collect::<Vec<_>>(),
+            ["arbitrary-frame-one", "arbitrary-frame-two"]);
+        assert!(receiver.try_recv().is_err());
+        assert!(guest.store.data().render_messages.borrow().is_none());
+        // Repeated renders retain each frame's messages exactly once.
+        assert_eq!(guest.render().unwrap().render_messages.len(), 2);
+        assert!(receiver.try_recv().is_err());
+    }
+}
