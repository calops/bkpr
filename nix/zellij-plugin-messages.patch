+fn running_guest(plugin_id: PluginId, client_id: ClientId, tab_index: usize, frame: &[u8], trap: bool)
+    -> (RunningPlugin, Receiver<(PluginInstruction, ErrorContext)>)
+{
+    let engine = Engine::default();
+    let module = Module::new(&engine, &guest_module(frame, trap)).unwrap();
+    let (sender, receiver) = unbounded();
+    let stdin_pipe = Arc::new(Mutex::new(VecDeque::new()));
+    let stdout_pipe = Arc::new(Mutex::new(VecDeque::new()));
+    let cwd = std::env::temp_dir();
+    let wasi_ctx = PluginLoader::create_wasi_ctx(
+        &cwd, &cwd, &cwd, &cwd, &"render-fixture".to_owned(), plugin_id,
+        stdin_pipe.clone(), stdout_pipe.clone(),
+    ).unwrap();
+    let env = PluginEnv {
+        plugin_id, client_id, tab_index: Some(tab_index),
+        plugin: PluginConfig {
+            path: PathBuf::from("render-fixture"),
+            _allow_exec_host_cmd: false,
+            location: RunPluginLocation::File(PathBuf::from("render-fixture")),
+            initial_userspace_configuration: Default::default(), initial_cwd: None,
+        },
+        permissions: Arc::new(Mutex::new(Some(HashSet::from([
+            PermissionType::MessageAndLaunchOtherPlugins, PermissionType::ReadApplicationState,
+        ])))),
+        senders: ThreadSenders {
+            to_plugin: Some(SenderWithContext::new(sender)),
+            should_silently_fail: true, ..Default::default()
+        },
+        wasi_ctx, stdin_pipe, stdout_pipe,
+        plugin_own_data_dir: cwd.clone(), plugin_own_cache_dir: cwd.clone(),
+        path_to_default_shell: PathBuf::from("/bin/sh"), default_shell: None,
+        layout_dir: None, plugin_cwd: cwd, session_env_vars: Default::default(),
+        input_pipes_to_unblock: Default::default(), input_pipes_to_block: Default::default(),
+        default_mode: InputMode::Normal, subscriptions: Default::default(),
+        keybinds: Keybinds::default(), intercepting_key_presses: false,
+        store_limits: StoreLimitsBuilder::new().build(), render_messages: Default::default(),
+    };
+    let mut store = Store::new(&engine, env);
+    let mut linker = Linker::new(&engine);
+    wasmi_wasi::add_to_linker(&mut linker, |env: &mut PluginEnv| &mut env.wasi_ctx).unwrap();
+    zellij_exports(&mut linker);
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    (RunningPlugin::new(store, instance, 10, 40), receiver)
+}
