+// The guest leaves stdin untouched, so decode the exact existing SDK wire written
+// by apply_event_to_plugin rather than testing a separate normalization helper.
+fn delivered_event(guest: &RunningPlugin) -> Event {
+    let bytes: Vec<u8> = guest.store.data().stdin_pipe.lock().unwrap().drain(..).collect();
+    let protobuf_bytes: Vec<u8> = serde_json::from_slice(&bytes).unwrap();
+    ProtobufEvent::decode(protobuf_bytes.as_slice()).unwrap().try_into().unwrap()
+}
