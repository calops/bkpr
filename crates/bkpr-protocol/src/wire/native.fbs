// Retired with image resource streams: everything from ImagePixelFormat through
// ImageResourcePayload is kept only for slot stability. Pane images travel inline
// in scenes, and decoders reject ImageResourcePayload.
enum ImagePixelFormat : ubyte { Rgb, Rgba, GrayAlpha, Gray }
enum ImageEncoding : ubyte { Raw, Zstd }
table ImageDescriptor {
  key:ImageKey (required);
  width:uint;
  height:uint;
  format:ImagePixelFormat;
  decoded_len:ulong;
}
table ImagePreparing { descriptor:ImageDescriptor (required); }
table ImageStart {
  descriptor:ImageDescriptor (required);
  encoding:ImageEncoding;
  encoded_len:ulong;
}
table ImageData { key:ImageKey (required); offset:ulong; data:[ubyte] (required); }
table ImageEnd { key:ImageKey (required); encoded_len:ulong; }
union ImageResource { ImagePreparing, ImageStart, ImageData, ImageEnd }
table ImageResourcePayload { value:ImageResource (required); }
table ChannelParticipant {
  id:string (required);
  kind:ParticipantKind;
  display_name:string (required);
}
table ChannelSummary {
  id:string (required);
  workspace_id:string (required);
  name:string (required);
  membership:MembershipMode;
  settings:ChannelSettings (required);
  last_sequence:ulong;
  read_through:ulong;
  unread_attention:bool;
  direct:bool;
  role_thread:RoleThread;
}
table ChannelMessageSummary {
  id:string (required);
  sequence:ulong;
  author:ChannelParticipant (required);
  posted_at_ms:ulong;
  intent:PostIntent;
  mentions:[string] (required);
  reply_to:string;
  attachments:[string] (required);
  mention_spans:[ChannelResolvedMentionSpan];
  source:ChannelSource;
  role:RoleAttribution;
}
table ChannelChange { sequence:ulong; kind:ChannelChangeKind; }
table AttachmentDescriptor {
  id:string (required);
  media_type:AttachmentMediaType;
  alt_text:string;
  byte_len:uint;
}
table ChannelMessage {
  message:ChannelMessageSummary (required);
  text:string (required);
  attachments:[AttachmentDescriptor] (required);
  current_delegation:string;
}
table ChannelResponseListed {
  channels:[ChannelSummary] (required);
  next_after:string;
}
table ChannelResponseMembers {
  participants:[ChannelParticipant] (required);
  next_after:string;
}
table ChannelResponseChannel { channel:ChannelSummary (required); }
table ChannelResponsePosted {
  message:ChannelMessageSummary (required);
  wake_count:uint;
  attention:bool;
  channel_id:string;
}
table ChannelResponseHistory {
  messages:[ChannelMessage] (required);
  next_before:OptionalU64;
  next_after:OptionalU64;
  cursor:ChannelCursor (required);
}
table ChannelResponseMessage {
  message:ChannelMessage (required);
}
table ChannelResponseReadPosition { through:ulong; }
table ChannelResponseChanges {
  cursor:ChannelCursor (required);
  changes:[ChannelChange] (required);
  more:bool;
  status:ChannelSubscriptionStatus;
}
table ChannelResponseAttachmentUploaded { attachment:AttachmentDescriptor (required); }
table ChannelResponseAttachment {
  attachment:AttachmentDescriptor (required);
  bytes:[ubyte] (required);
}
table ChannelResponseArchivedWorkspaces {
  workspace_ids:[string] (required);
  next_after:string;
}
table ChannelResponseExplicitMembers {
  members:[string] (required);
  next_after:string;
}
table ChannelCatalogUpsert {
  channel:ChannelSummary (required);
  // Do not reuse the former experimental attention slot.
}
table ChannelCatalogWorkspaceClosed { workspace_id:string (required); }
union ChannelCatalogChangeBody { ChannelCatalogUpsert, ChannelCatalogWorkspaceClosed }
table ChannelCatalogChange { body:ChannelCatalogChangeBody (required); }
table ChannelResponseCatalogSnapshot {
  channels:[ChannelSummary] (required);
  cursor:ChannelCatalogCursor (required);
  next_after:ChannelCatalogPage;
}
table ChannelResponseCatalogChanges {
  cursor:ChannelCatalogCursor (required);
  changes:[ChannelCatalogChange] (required);
  more:bool;
}
table ChannelResponseCatalogReset {}
table ChannelRosterEntry {
  participant:ChannelParticipant (required);
  binding:ChannelMentionBinding;
  role:RoleAttribution;
}
table ChannelResponseUserRoster {
  participants:[ChannelRosterEntry] (required);
  next_after:string;
}
union ChannelResponse {
  ChannelResponseListed,
  ChannelResponseMembers,
  ChannelResponseChannel,
  ChannelResponsePosted,
  ChannelResponseHistory,
  ChannelResponseMessage,
  ChannelResponseReadPosition,
  ChannelResponseChanges,
  ChannelResponseAttachmentUploaded,
  ChannelResponseAttachment,
  ChannelResponseArchivedWorkspaces,
  ChannelResponseExplicitMembers,
  ChannelResponseCatalogSnapshot,
  ChannelResponseCatalogChanges,
  ChannelResponseCatalogReset,
  ChannelResponseUserRoster
}
table ChannelPayload { response:ChannelResponse (required); }
table RoleAttribution { role:WorkspaceRole = Coordinator; grant_id:string (required); }
table RoleThread { role:WorkspaceRole = Coordinator; archived:bool; }
table RoleGrant {
  id:string (required);
  workspace_id:string (required);
  role:WorkspaceRole = Coordinator;
  holder:ChannelMentionBinding (required);
  origin:RoleOrigin = Approval;
  granted_at_ms:ulong;
  channel_id:string (required);
  display_name:string (required);
}
table RoleApproval {
  id:string (required);
  workspace_id:string (required);
  role:WorkspaceRole = Coordinator;
  requester:ChannelMentionBinding (required);
  participant:ChannelParticipant (required);
  prior_holder:RoleGrant;
  expires_at_ms:ulong;
  workspace_name:string (required);
  decision_generation:ulong;
}
table RoleResponseActivity {}
table RoleResponseSnapshot {
  revision:ulong;
  grants:[RoleGrant] (required);
  approvals:[RoleApproval] (required);
}
table RoleResponseUpdated { grant:RoleGrant; }
union RoleResponse { RoleResponseActivity, RoleResponseSnapshot, RoleResponseUpdated }
table RolePayload { response:RoleResponse (required); }
union Payload { ControlPayload, PanePayload, ImageResourcePayload, ChannelPayload, RolePayload }
table Request { version:uint; operation:Operation (required); }
table OptionalPayload { value:Payload (required); }
table OptionalFailure { value:RequestFailure (required); }
table Response { version:uint; ok:bool; result:OptionalPayload; error:string; failure:OptionalFailure; }

table ChannelMentionSpan {
  start:uint;
  end:uint;
  participant_id:string (required);
}
table ChannelResolvedMentionSpan {
  start:uint;
  end:uint;
  participant:ChannelParticipant (required);
}
