// Independent SSH attachment control protocol, generated with planus-cli =1.3.0.
// Versioned independently of the native daemon wire family.
namespace remote_wire;

table Hello {
  session_name:string (required);
  native_family:uint;
  required_capabilities:ulong;
  connection_nonce:[ubyte] (required);
  forward_agent:bool;
}
table SessionInfo {
  name:string (required);
  session_id:string (required);
  daemon_id:string (required);
}
table UnixPath { bytes:[ubyte] (required); }
union AgentPath { UnixPath }
// A missing outer table means absence; a present table MUST contain its union.
table OptionalAgentPath { value:AgentPath (required); }
table Welcome {
  session:SessionInfo (required);
  connection_nonce:[ubyte] (required);
  capabilities:ulong;
  agent_socket:OptionalAgentPath;
  heartbeat_interval_ms:uint;
  lease_timeout_ms:uint;
}
table Failure { message:string (required); }
table Ping { sequence:ulong; }
table Pong { sequence:ulong; }
table Close {}
union Control { Hello, Welcome, Failure, Ping, Pong, Close }
table Message { control:Control (required); }
root_type Message;
