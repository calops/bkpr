+test "image load: retain_source keeps the exact compressed payload" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+    const payload = @embedFile("testdata/image-rgb-zlib_deflate-128x96-2147483647-raw.data");
+
+    for ([_]bool{ true, false }) |retain| {
+        var cmd: command.Command = .{
+            .control = .{ .transmit = .{
+                .format = .rgb,
+                .medium = .direct,
+                .compression = .zlib_deflate,
+                .height = 96,
+                .width = 128,
+                .image_id = 31,
+            } },
+            .data = try alloc.dupe(u8, payload),
+        };
+        defer cmd.deinit(alloc);
+        var limits: LoadingImage.Limits = .direct;
+        limits.retain_source = retain;
+        var loading = try LoadingImage.init(io, alloc, &cmd, limits);
+        defer loading.deinit(alloc);
+        var img = try loading.complete(alloc);
+        defer img.deinit(alloc);
+
+        try testing.expect(img.compression == .none);
+        if (retain) {
+            const source = img.currentSource().?;
+            try testing.expect(source.format == .rgb);
+            try testing.expect(source.compression == .zlib_deflate);
+            try testing.expectEqualSlices(u8, payload, source.bytes);
+            try testing.expectEqual(img.data.len() + payload.len, img.storageSize());
+        } else {
+            try testing.expect(img.currentSource() == null);
+            try testing.expectEqual(img.data.len(), img.storageSize());
+        }
+    }
+
+    // Raw payloads equal the decoded pixels, so nothing extra is retained.
+    var raw: command.Command = .{
+        .control = .{ .transmit = .{
+            .format = .rgb,
+            .medium = .direct,
+            .compression = .none,
+            .width = 20,
+            .height = 15,
+            .image_id = 31,
+        } },
+        .data = try alloc.dupe(u8, @embedFile("testdata/image-rgb-none-20x15-2147483647-raw.data")),
+    };
+    defer raw.deinit(alloc);
+    var limits: LoadingImage.Limits = .direct;
+    limits.retain_source = true;
+    var loading = try LoadingImage.init(io, alloc, &raw, limits);
+    defer loading.deinit(alloc);
+    var img = try loading.complete(alloc);
+    defer img.deinit(alloc);
+    try testing.expect(img.currentSource() == null);
+}
