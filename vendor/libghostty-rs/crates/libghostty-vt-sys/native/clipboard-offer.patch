         one_time: bool = false,
+        paste_offer_id: u64 = 0,
     };
 
     pub fn deinit(self: *Grants, alloc: Allocator) void {
@@ -72,6 +73,21 @@ pub const Grants = struct {
         }
     }
 
+    /// Attach embedder correlation only to a newly minted one-time paste grant.
+    pub fn grantPaste(self: *Grants, alloc: Allocator, pw: []const u8, offer_id: u64) Allocator.Error!void {
+        try self.grant(alloc, pw, .read, true);
+        const idx = self.findIndex(pw) orelse return;
+        if (self.entries.items[idx].one_time) self.entries.items[idx].paste_offer_id = offer_id;
+    }
+
+    /// Inspect a validated paste password without consuming it. In particular,
+    /// listing targets must not burn the subsequent data-read grant.
+    pub fn pasteOffer(self: *const Grants, pw: []const u8) u64 {
+        const idx = self.findIndex(pw) orelse return 0;
+        const entry = self.entries.items[idx];
+        return if (entry.one_time and entry.read) entry.paste_offer_id else 0;
+    }
+
     /// Check whether pw grants the given direction. A one-time grant is
     /// consumed by this check even when the direction doesn't match,
     /// matching kitty's pop-on-check behavior.
@@ -236,3 +252,22 @@ test "generateOtp: sys override supplies entropy without an Io source" {
     const otp = try generateOtp(std.Io.failing);
     for (otp) |c| try testing.expect(std.mem.indexOfScalar(u8, otp_alphabet, c) != null);
 }
+
+test "paste offer correlation is exact and never a session grant" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var grants: Grants = .{};
+    defer grants.deinit(alloc);
+    try grants.grantPaste(alloc, "first", 11);
+    try grants.grantPaste(alloc, "second", 22);
+    try grants.grant(alloc, "session", .read, false);
+    try testing.expectEqual(@as(u64, 11), grants.pasteOffer("first"));
+    try testing.expectEqual(@as(u64, 22), grants.pasteOffer("second"));
+    try testing.expectEqual(@as(u64, 0), grants.pasteOffer("session"));
+    try testing.expectEqual(@as(u64, 0), grants.pasteOffer("wrong"));
+    try testing.expect(grants.use(alloc, "first", .read));
+    try testing.expectEqual(@as(u64, 0), grants.pasteOffer("first"));
+    try testing.expectEqual(@as(u64, 22), grants.pasteOffer("second"));
+    try testing.expect(!grants.use(alloc, "second", .write));
+    try testing.expectEqual(@as(u64, 0), grants.pasteOffer("second"));
+}
